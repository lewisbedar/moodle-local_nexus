<div class="fc-dashboard">

  <section class="fc-hero fc-hero-large">
    {{#hero.hasicon}}<img src="{{hero.iconurl}}" alt="" class="fc-hero-watermark">{{/hero.hasicon}}
    <div class="fc-hero-content">
      <h1>{{title}}</h1>
      <p>{{subtitle}}</p>

      <div class="fc-hero-actions">
        <a href="{{hero.primaryurl}}" class="btn btn-primary">{{hero.primarylabel}}</a>
        <a href="{{hero.secondaryurl}}" class="btn btn-light">{{hero.secondarylabel}}</a>
      </div>
    </div>
    <div class="fc-hero-user">
      <img src="{{user.pictureurl}}" alt="" class="fc-hero-user-picture">
      <span>{{user.fullname}}</span>
    </div>
    {{#hero.haslogo}}<img src="{{hero.logourl}}" alt="" class="fc-hero-logo">{{/hero.haslogo}}
  </section>

  {{> local_nexus/dock }}


  {{#hascourses}}
    <section class="fc-courses-section">
      <div class="fc-section-heading">
        <p class="fc-kicker">{{#str}}MYCOURSES, local_nexus{{/str}}</p>
        <h2>{{#str}}RECENTCOURSES, local_nexus{{/str}}</h2>
      </div>

      <div class="fc-course-grid">
        {{#courses}}
          <a href="{{url}}" class="fc-course-card {{#hidden}}fc-course-card-hidden{{/hidden}}">
            {{#hasimage}}<img src="{{imageurl}}" alt="" class="fc-course-card-image">{{/hasimage}}
            {{^hasimage}}<span class="fc-course-card-image fc-course-card-image-empty" aria-hidden="true"></span>{{/hasimage}}
            <strong>{{fullname}}</strong>
            {{#hassummary}}<span>{{summary}}</span>{{/hassummary}}
            {{#haslastaccess}}<em>{{#str}}lastaccess, local_nexus{{/str}} {{lastaccess}}</em>{{/haslastaccess}}
          </a>
        {{/courses}}
      </div>
    </section>
  {{/hascourses}}


  {{#hasnews}}
    <section class="fc-news-section">
      <div class="fc-section-heading">
        <p class="fc-kicker">{{#str}}nexusnews, local_nexus{{/str}}</p>
        <h2>{{#str}}latestnews, local_nexus{{/str}}</h2>
      </div>

      <div class="fc-news-grid">
        {{#news}}
          <article class="fc-news-card">
            {{#hasimage}}<img src="{{imageurl}}" alt="" class="fc-news-card-image">{{/hasimage}}
            <h3>{{title}}</h3>
            <p>{{{summary}}}</p>
            {{#hasurl}}<a href="{{url}}">{{#str}}readmore, local_nexus{{/str}}</a>{{/hasurl}}
          </article>
        {{/news}}
      </div>
    </section>
  {{/hasnews}}

  <section class="fc-cards">
    <a href="/my/courses.php" class="fc-card">
      <strong>{{#str}}dashboardcardcourses, local_nexus{{/str}}</strong>
      <span>{{#str}}dashboardcardcoursesdesc, local_nexus{{/str}}</span>
    </a>

    <a href="/course/index.php" class="fc-card">
      <strong>{{#str}}dashboardcardcatalog, local_nexus{{/str}}</strong>
      <span>{{#str}}dashboardcardcatalogdesc, local_nexus{{/str}}</span>
    </a>

    <a href="https://www.docs.flux-croises.fr" class="fc-card">
      <strong>{{#str}}dashboardcarddocs, local_nexus{{/str}}</strong>
      <span>{{#str}}dashboardcarddocsdesc, local_nexus{{/str}}</span>
    </a>
  </section>

</div>
