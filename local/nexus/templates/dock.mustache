<section class="fc-dock-wrap">
  {{#hasdockcontrols}}
    <button type="button" class="fc-dock-arrow fc-dock-arrow-prev" data-nexus-dock-prev aria-label="{{#str}}dockprevious, local_nexus{{/str}}">‹</button>
  {{/hasdockcontrols}}

  <div class="fc-dock" data-nexus-dock>
    {{#applications}}
      {{#locked}}
        <span class="fc-dock-item fc-locked" title="{{description}}">
          <img src="{{icon}}" alt="">
          <span>{{name}}</span>
        </span>
      {{/locked}}
      {{^locked}}
        <a href="{{url}}" class="fc-dock-item" title="{{description}}">
          <img src="{{icon}}" alt="">
          <span>{{name}}</span>
        </a>
      {{/locked}}
    {{/applications}}
  </div>

  {{#hasdockcontrols}}
    <button type="button" class="fc-dock-arrow fc-dock-arrow-next" data-nexus-dock-next aria-label="{{#str}}docknext, local_nexus{{/str}}">›</button>
  {{/hasdockcontrols}}
</section>
