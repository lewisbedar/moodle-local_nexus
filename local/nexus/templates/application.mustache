<div class="fc-dashboard">

  <section class="fc-app-detail-hero">
    <div class="fc-app-detail-icon">
      <img src="{{icon}}" alt="">
    </div>

    <div class="fc-app-detail-content">
      <p class="fc-kicker">Application Flux Croisés</p>
      <h1>{{name}}</h1>
      <p>{{{description}}}</p>

      <div class="fc-app-detail-actions">
        <a href="{{url}}" class="btn btn-primary">{{#str}}openapplication, local_nexus{{/str}}</a>
        <a href="/applications" class="btn btn-light">{{#str}}backtoapplications, local_nexus{{/str}}</a>
      </div>
    </div>
  </section>

  <section class="fc-cards">
    <div class="fc-card">
      <strong>Statut</strong>
      <span>{{#locked}}Accès réservé{{/locked}}{{^locked}}Public{{/locked}}{{#hasversion}} · {{#str}}version, local_nexus{{/str}} {{version}}{{/hasversion}}{{#hascategory}} · {{category}}{{/hascategory}}</span>
    </div>

    <div class="fc-card">
      <strong>Documentation</strong>
      <span>Guides, tutoriels et aide à venir.</span>
    </div>

    <div class="fc-card">
      <strong>Support</strong>
      <span>Besoin d’aide ? Consultez les ressources Flux Croisés.</span>
    </div>
  </section>

</div>
