<section class="fc-hero fc-hero-large">
  {{#hasicon}}<img src="{{iconurl}}" alt="" class="fc-hero-watermark">{{/hasicon}}
  <div class="fc-hero-content">
    <h1>{{title}}</h1>
    <p>{{subtitle}}</p>

    <div class="fc-hero-actions">
      <a href="{{primaryurl}}" class="btn btn-primary">{{primarylabel}}</a>
      <a href="{{secondaryurl}}" class="btn btn-light">{{secondarylabel}}</a>
    </div>
  </div>
  {{#user.hasuser}}
    <div class="fc-hero-user">
      <img src="{{user.pictureurl}}" alt="" class="fc-hero-user-picture">
      <span>{{user.fullname}}</span>
    </div>
  {{/user.hasuser}}
  {{#haslogo}}<img src="{{logourl}}" alt="" class="fc-hero-logo">{{/haslogo}}
</section>
