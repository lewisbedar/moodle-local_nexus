{{#hascourses}}
  <section class="fc-courses-section">
    <div class="fc-section-heading">
      <p class="fc-kicker">{{#str}}MYCOURSES, local_nexus{{/str}}</p>
      <h2>{{customtitle}}</h2>
    </div>

    <div class="fc-course-grid">
      {{#courses}}
        <a href="{{url}}" class="fc-course-card {{#hidden}}fc-course-card-hidden{{/hidden}}">
          {{#hasimage}}<img src="{{imageurl}}" alt="" class="fc-course-card-image">{{/hasimage}}
          {{^hasimage}}<span class="fc-course-card-image fc-course-card-image-empty" aria-hidden="true"></span>{{/hasimage}}
          <strong>{{fullname}}</strong>
          {{#hassummary}}<span>{{summary}}</span>{{/hassummary}}
          {{#haslastaccess}}<em>{{#str}}lastaccess, local_nexus{{/str}} {{lastaccess}}</em>{{/haslastaccess}}
        </a>
      {{/courses}}
    </div>
  </section>
{{/hascourses}}
