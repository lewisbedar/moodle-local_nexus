<div class="fc-dashboard">

  <section class="fc-hero">
    <div>
      <p class="fc-kicker">Flux Croisés</p>
      <h1>Applications</h1>
      <p>Retrouvez les outils créatifs, ressources et services de Flux Croisés.</p>
    </div>
  </section>

  <section class="fc-app-grid">
    {{#applications}}
      <article class="fc-app-card {{#locked}}fc-app-card-locked{{/locked}}">
        <div class="fc-app-icon">
          <img src="{{icon}}" alt="">
        </div>

        <div class="fc-app-content">
          <h2>{{name}}</h2>
          {{#hascategory}}<p class="fc-app-category">{{category}}</p>{{/hascategory}}
          <p>{{{description}}}</p>
          {{#hasversion}}<p class="fc-app-version">{{#str}}version, local_nexus{{/str}} {{version}}</p>{{/hasversion}}

          <span class="fc-app-badge">
            {{#locked}}Accès réservé{{/locked}}
            {{^locked}}Public{{/locked}}
          </span>

<a href="/applications/{{slug}}" class="btn btn-primary fc-app-button">
  {{#str}}discover, local_nexus{{/str}}
</a>
        </div>
      </article>
    {{/applications}}
  </section>

</div>
